{
  "name": "cyrion-community",
  "version": "0.1.0-alpha.2",
  "description": "Local-first multi-agent terminal orchestrator for authorized security assessment workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X3r0K/Cyrion-AI-CLI.git"
  },
  "homepage": "https://github.com/X3r0K/Cyrion-AI-CLI#readme",
  "bugs": "https://github.com/X3r0K/Cyrion-AI-CLI/issues",
  "bin": {
    "cyrion": "dist/cyrion.js"
  },
  "files": [
    ".env.example",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "agents/",
    "bun.lock",
    "containers/",
    "cyrion.models.example.json",
    "dist/",
    "docs/",
    "fixtures/",
    "mcp.example.json",
    "skills/",
    "workers/"
  ],
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bench": "bun run apps/cli/src/index.ts bench --sandbox local --report BENCHMARKS.md",
    "build": "bun run scripts/build-release.ts",
    "check": "bun run typecheck && bun test",
    "demo": "bun run apps/cli/src/index.ts demo",
    "demo:headless": "bun run apps/cli/src/index.ts demo --headless",
    "prepack": "bun run build",
    "release:artifacts": "bun run release:check && bun run scripts/generate-release-artifacts.ts",
    "release:check": "bun run check && bun run build && bun run scripts/verify-release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.29",
    "@opentui/core": "0.5.10"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.5.10",
    "@opentui/core-darwin-x64": "0.5.10",
    "@opentui/core-linux-arm64": "0.5.10",
    "@opentui/core-linux-arm64-musl": "0.5.10",
    "@opentui/core-linux-x64": "0.5.10",
    "@opentui/core-linux-x64-musl": "0.5.10",
    "@opentui/core-win32-arm64": "0.5.10",
    "@opentui/core-win32-x64": "0.5.10"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "playwright": "^1.63.0",
    "typescript": "5.9.2"
  }
}
