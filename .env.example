# Cyrion provider selection. Both values are required together.
# Use `opencode models <provider>` to find the exact model ID.
CYRION_PROVIDER_ID=
CYRION_MODEL_ID=

# General terminal defaults. CLI flags override planner, mode, and fixture.
# fixture is fully deterministic; opencode enables guarded provider review.
# Tool execution, findings, and evidence remain owned by isolated fixtures.
CYRION_DEFAULT_PLANNER=fixture
CYRION_DEFAULT_WORKERS=fixture
CYRION_DEFAULT_MODE=autonomous
CYRION_DEFAULT_FIXTURE=known-positive
# auto follows NO_COLOR; color and monochrome explicitly select a profile.
CYRION_COLOR_MODE=auto

# Configure exactly the provider credential you intend to use. OpenCode also
# supports credentials stored by `opencode auth login`.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Custom and local OpenAI-compatible providers belong in opencode.json. Keep
# their credentials in environment variables and reference them with {env:NAME}.

# Direct model access, used by `cyrion models` and `--planner llm`.
# The Settings page (press 5 in the terminal) writes these four for you.
# Point these at a local server (Ollama, vLLM, llama.cpp) or any hosted
# OpenAI-compatible API. For more than one endpoint, copy
# cyrion.models.example.json to cyrion.models.json instead.
# CYRION_LLM_BASE_URL=http://127.0.0.1:11434
# CYRION_LLM_MODEL=qwen3:14b
# CYRION_LLM_KIND=ollama
# CYRION_LLM_API_KEY_ENV=OPENAI_API_KEY
