{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@cyrion/contracts": ["packages/contracts/src/index.ts"],
      "@cyrion/controller": ["packages/controller/src/index.ts"],
      "@cyrion/evidence": ["packages/evidence/src/index.ts"],
      "@cyrion/reporting": ["packages/reporting/src/index.ts"],
      "@cyrion/runtime-opencode": ["packages/runtime-opencode/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
